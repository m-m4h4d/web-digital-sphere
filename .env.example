# Copy to .env.local (or set in your host's dashboard) to email form
# submissions through Resend: https://resend.com/api-keys
# Without these, submissions are logged to the console in development and
# rejected in production.
RESEND_API_KEY=
# Where submissions go. Separate multiple addresses with commas.
CONTACT_TO_EMAIL=
# Optional. Must be on a domain verified in Resend; defaults to Resend's
# test sender, which can only deliver to your own Resend account email.
CONTACT_FROM_EMAIL=
